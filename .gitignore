# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
*.local

# ---------- Rust / Tauri ----------
target/
src-tauri/target/
src-tauri/gen/

# ---------- 字体与图标派生产物（由脚本生成，不入 git）----------
# 源文件 assets/icon.svg 与 assets/fonts.lock.json 是文本，正常提交。
src/fonts/
public/fonts/
src-tauri/icons/
*.woff2
*.ttf
*.otf
*.ico
*.icns

# ---------- 编辑器与系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------- 构建工具临时文件 ----------
# vite / vitest 会在配置目录旁生成 config 的时间戳副本
vitest.config.ts.timestamp-*
vite.config.ts.timestamp-*

# ---------- 日志与临时 ----------
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.vitest/

# ---------- 本地工作区示例（写作数据不进仓库）----------
/scratch/

# ---------- 工具本地数据 ----------
# .workbuddy 存放 agent 的会话记忆与工作日志，属于本机数据而非项目源码。
# 入库会被 prettier --check "**/*.{md}" 扫到并因格式不符让 CI 失败。
.workbuddy/
